# Entorno de DESARROLLO (Raspberry Pi) - ComandaPro
# Copiar a: back-end/.env   (cp .env.example.dev .env)
#
# Base de datos creada con las migraciones de database/ (estado de desarrollo):
#   mysql -u <usuario> -p comandapro < database/migrations/001_*.sql
#   ... (procedures y seeds correspondientes)
# Para arrancar el backend: pnpm dev  (nodemon, recarga automatica)

PORT=3000

# Base de datos (MariaDB) - migraciones de database/
DB_HOST=127.0.0.1
DB_USER=comandapro_user
DB_PASSWORD=tu_password_aqui
DB_NAME=comandapro

# JWT Configuration
JWT_SECRET=generar_string_aleatorio_largo_aqui
JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d            # documentado pero NO usado por el código (ver JWT_REFRESH_EXPIRES_DAYS)
JWT_REFRESH_EXPIRES_DAYS=7

# BCrypt Configuration
BCRYPT_WORK_FACTOR=12

# Printer (AON PR-255 ESC/POS) - en desarrollo NO imprime, solo loguea bytes
PRINTER_ENABLED=true
PRINTER_INTERFACE=usb            # tcp | usb
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_USB=/dev/usb/lp0         # Linux (Raspberry Pi)
PRINTER_WINDOWS_NAME=
PRINTER_CHARSET=CP850
PRINTER_WIDTH=80                 # mm (80 -> 48 columnas, 58 -> 32)
PRINTER_TIMEOUT_MS=3000
PRINTER_DRY_RUN=true             # true = imprime en consola (desarrollo)
